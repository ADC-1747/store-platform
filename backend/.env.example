# Backend Environment Configuration
# Copy this file to .env and configure your settings

# Default environment for store provisioning
# Options: 'local' (for Kind/k3d/Minikube) or 'prod' (for k3s VPS)
# This determines which Helm values file to use:
#   - 'local' -> values-local.yaml
#   - 'prod' -> values-prod.yaml
DEFAULT_ENVIRONMENT=prod

# Backend server port
PORT=3001

# Production domain for store provisioning
# This is used as the default domain when provisioning stores in production environment
# Format: yourdomain.com (without protocol or subdomain)
# Example: example.com
# Individual stores will be created as: <store-name>.yourdomain.com
# Can be overridden per-store via the domain parameter in the API request
PRODUCTION_DOMAIN=yourdomain.com
