# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/

node_modules
node_modules/*
backend/node_modules
backend/node_modules/*
storefront/node_modules
storefront/node_modules/*

.git
.gitignore
Dockerfile
docker-compose.yml

.env
.env.*

dist
build
.next
coverage

*.log

